# Variables de entorno para Vercel
# Copia este archivo a tu panel de control de Vercel como Environment Variables

# Clave secreta para sesiones (genera una nueva y segura)
SECRET_KEY=tu-clave-secreta-muy-segura-aqui

# API Keys para los modelos de IA
ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aqui
OPENAI_API_KEY=tu-api-key-de-openai-aqui
GOOGLE_API_KEY=tu-api-key-de-google-aqui

# Entorno
FLASK_ENV=production

# Nota: En Vercel, la base de datos SQLite es temporal. 
# Para producción, considera usar una base de datos externa como:
# - PostgreSQL (Supabase, Neon, Railway)
# - MySQL (PlanetScale, Aiven)
# - MongoDB (MongoDB Atlas)
# 
# Luego configura la variable DATABASE_URL con la conexión apropiada
